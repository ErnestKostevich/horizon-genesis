{
  "id": "code-review-on-pr",
  "name": "Code Review on PR",
  "description": "Fetches a GitHub PR diff and runs code-review, security-scan, and write-test skills against it. Produces a markdown review ready to paste as a PR comment.",
  "category": "developer",
  "tier": "built_in",
  "trigger": "manual",
  "enabled": false,
  "inputs": [
    {
      "name": "pr_url",
      "type": "string",
      "required": true,
      "description": "Full GitHub PR URL, e.g. https://github.com/owner/repo/pull/123"
    }
  ],
  "steps": [
    {
      "type": "plugin",
      "action": "fetch_pr_diff",
      "params": {
        "pluginId": "github",
        "tool": "get_pr_diff",
        "args": {
          "url": "{{inputs.pr_url}}"
        }
      },
      "stopOnError": true
    },
    {
      "type": "plugin",
      "action": "fetch_pr_meta",
      "params": {
        "pluginId": "github",
        "tool": "get_pr",
        "args": {
          "url": "{{inputs.pr_url}}"
        }
      },
      "stopOnError": false
    },
    {
      "type": "skill",
      "action": "code-review",
      "params": {
        "skill": "code-review",
        "args": {
          "diff": "{{steps.fetch_pr_diff.output}}",
          "title": "{{steps.fetch_pr_meta.output.title}}",
          "description": "{{steps.fetch_pr_meta.output.body}}"
        }
      },
      "stopOnError": false
    },
    {
      "type": "skill",
      "action": "security-scan",
      "params": {
        "skill": "security-scan",
        "args": {
          "diff": "{{steps.fetch_pr_diff.output}}",
          "checkSecrets": true,
          "checkDependencies": true
        }
      },
      "stopOnError": false
    },
    {
      "type": "skill",
      "action": "write-test",
      "params": {
        "skill": "write-test",
        "args": {
          "diff": "{{steps.fetch_pr_diff.output}}",
          "mode": "coverage_audit"
        }
      },
      "stopOnError": false
    },
    {
      "type": "skill",
      "action": "compose_review",
      "params": {
        "skill": "summarize-anything",
        "args": {
          "inputs": [
            "{{steps.code-review.output}}",
            "{{steps.security-scan.output}}",
            "{{steps.write-test.output}}"
          ],
          "format": "pr_review_comment",
          "template": "## Automated review\n\n### Code review\n{{code-review}}\n\n### Security scan\n{{security-scan}}\n\n### Test coverage\n{{write-test}}\n\n_Generated by Horizon AI._"
        }
      },
      "stopOnError": true
    },
    {
      "type": "plugin",
      "action": "post_comment",
      "params": {
        "pluginId": "github",
        "tool": "post_pr_comment",
        "args": {
          "url": "{{inputs.pr_url}}",
          "body": "{{steps.compose_review.output}}"
        }
      },
      "stopOnError": false
    },
    {
      "type": "clipboard_write",
      "action": "copy_to_clipboard",
      "params": {
        "text": "{{steps.compose_review.output}}"
      }
    },
    {
      "type": "notify",
      "action": "Review ready",
      "params": {
        "title": "Code Review on PR",
        "body": "Review posted and copied to clipboard."
      }
    }
  ],
  "outputs": {
    "primaryChannel": "github_comment",
    "fallback": "clipboard"
  }
}
